#!/usr/bin/env python3
"""Persistent OpenOCD daemon + command sender for the DE1-SoC (Cortex-A9).

Reuses ONE long-lived OpenOCD daemon instead of spawning + SIGKILL-ing a fresh
openocd per command. The open/hard-kill churn is the main cause of USB-Blaster II
wedging (SIGKILL never releases the USB interface -> stale libusb endpoints ->
LIBUSB_ERROR_TIMEOUT on the next open). Keeping one daemon open and shutting it
down cleanly cuts the wedges dramatically. test.py reuses this daemon too.

Talk to the daemon over its TCL RPC port (6666) -- the same protocol test.py uses.

Usage:
    openocd/ocd start                    # launch the daemon (idempotent)
    openocd/ocd cmd "halt ; reg pc"      # send ;-separated commands, print reply
    openocd/ocd status                   # up | down
    openocd/ocd stop                     # clean shutdown (never SIGKILL)
    openocd/ocd recover                  # USB reset a wedged adapter (no replug)
"""

import ctypes
import ctypes.util
import socket
import subprocess
import sys
import time

from pathlib import Path


# USB-Blaster II (Altera). PID is 0x6010 before OpenOCD's firmware download,
# 0x6810 after.
UB2_VID  = 0x09FB
UB2_PIDS = (0x6810, 0x6010)


ROOT = Path(__file__).resolve().parent.parent
CFG  = ROOT / "openocd" / "de1soc.cfg"
PORT = 6666
TERM = b"\x1a"


def is_up() -> bool:
    try:
        socket.create_connection(("localhost", PORT), timeout=0.5).close()
        return True
    except OSError:
        return False


def rpc(command: str, timeout: float = 30.0) -> str:
    sock = socket.create_connection(("localhost", PORT), timeout=timeout)
    sock.settimeout(timeout)
    try:
        sock.sendall(command.encode() + TERM)
        buf = b""
        while not buf.endswith(TERM):
            chunk = sock.recv(4096)
            if not chunk:
                break
            buf += chunk
        return buf.rstrip(TERM).decode(errors="replace")
    finally:
        sock.close()


def start() -> None:
    if is_up():
        print(f"openocd daemon already up on :{PORT}")
        return

    proc = subprocess.Popen(
        ["openocd", "-f", str(CFG), "-c", "init"],
        cwd=str(ROOT),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    for _ in range(40):
        if proc.poll() is not None:
            sys.exit("openocd exited during startup (USB-Blaster wedged? power-cycle it)")
        if is_up():
            print(f"openocd daemon up on :{PORT} (pid {proc.pid})")
            return
        time.sleep(0.25)

    proc.kill()
    sys.exit("openocd did not come up (USB-Blaster wedged? power-cycle it)")


def stop() -> None:
    if not is_up():
        print("no daemon running")
        return
    try:
        rpc("shutdown", timeout=3.0)   # clean release of the USB interface
    except OSError:
        pass
    print("daemon shut down")


def _libusb_reset() -> str:
    """USB port-reset the adapter via libusb -- may clear a wedge (stale endpoints)
    without a physical replug. Best-effort; macOS support is limited."""
    path = None
    for cand in ("/opt/homebrew/lib/libusb-1.0.dylib", "/usr/local/lib/libusb-1.0.dylib"):
        if Path(cand).exists():
            path = cand
            break
    if path is None:
        path = ctypes.util.find_library("usb-1.0")
    if path is None:
        return "libusb-1.0 not found"

    lib = ctypes.CDLL(path)
    lib.libusb_open_device_with_vid_pid.restype = ctypes.c_void_p
    lib.libusb_open_device_with_vid_pid.argtypes = [ctypes.c_void_p, ctypes.c_uint16, ctypes.c_uint16]
    lib.libusb_reset_device.argtypes = [ctypes.c_void_p]
    lib.libusb_close.argtypes = [ctypes.c_void_p]
    lib.libusb_exit.argtypes = [ctypes.c_void_p]

    ctx = ctypes.c_void_p()
    if lib.libusb_init(ctypes.byref(ctx)) != 0:
        return "libusb_init failed"
    try:
        for pid in UB2_PIDS:
            handle = lib.libusb_open_device_with_vid_pid(ctx, UB2_VID, pid)
            if handle:
                rc = lib.libusb_reset_device(handle)
                lib.libusb_close(handle)
                if rc == 0:
                    return f"reset {UB2_VID:04x}:{pid:04x} -> OK"
                if rc == -5:   # LIBUSB_ERROR_NOT_FOUND: re-enumerated (effectively reset)
                    return f"reset {UB2_VID:04x}:{pid:04x} -> re-enumerated (rc=-5)"
                return f"reset {UB2_VID:04x}:{pid:04x} -> rc={rc} (macOS may not support USB reset)"
        return f"USB-Blaster ({UB2_VID:04x}) not found -- already gone/replugged?"
    finally:
        lib.libusb_exit(ctx)


def recover() -> None:
    # Release any hung openocd holding the device, then USB-reset it. The reset
    # re-enumerates the adapter to its blank 0x6010 state; OpenOCD re-downloads
    # its firmware on the next start, so give it a few seconds to settle before
    # you launch a daemon (immediate spawns during re-enumeration will fail).
    subprocess.run(["pkill", "-9", "openocd"], stderr=subprocess.DEVNULL)
    time.sleep(0.5)
    print(_libusb_reset())
    time.sleep(3.0)
    print("adapter reset; wait a moment before `ocd start` (firmware re-download)")


def main() -> None:
    if len(sys.argv) < 2:
        sys.exit(__doc__)

    op = sys.argv[1]

    if op == "start":
        start()
    elif op == "stop":
        stop()
    elif op == "recover":
        recover()
    elif op == "status":
        print("up" if is_up() else "down")
    elif op == "cmd":
        if not is_up():
            start()
        print(rpc(" ; ".join(sys.argv[2:])))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
